# Optional: FastAPI backend URL used by the UI proxy.
FASTAPI_URL="http://127.0.0.1:8080"

# Optional: UI dev server port.
PORT="3000"

# Optional: disable HMR for browser environments where websocket/HMR is flaky.
DISABLE_HMR="true"

# Optional provider keys for external experiments. Prefer saving through Settings.
# Never commit a real .env file.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional: shared API token if the backend is configured to require one.
TALENT_POOL_API_TOKEN=""
